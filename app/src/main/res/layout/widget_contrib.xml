<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
    <ImageView android:id="@+id/w_image" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scaleType="fitStart" android:contentDescription="@null" />
    <TextView android:id="@+id/w_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#B0B0B0" android:textSize="11sp" android:maxLines="2" />
</LinearLayout>
